{
  "name": "particle",
  "version": "1.0.0",
  "description": "Source build tooling for rahulkar.com (Jekyll portfolio)",
  "private": true,
  "author": "Rahul Kar",
  "license": "ISC",
  "scripts": {
    "build:css": "sass src/styles/main.scss assets/css/main.css --style=compressed --no-source-map",
    "build:js": "esbuild src/js/app.js --bundle --minify --format=iife --target=es2018 --outfile=assets/js/main.js",
    "build:orbit": "esbuild src/js/orbit.ts --bundle --minify --format=iife --target=es2018 --outfile=assets/js/orbit.js",
    "build:notes": "esbuild src/js/notes.js --bundle --minify --format=iife --target=es2018 --outfile=assets/js/notes.js",
    "build": "npm run build:css && npm run build:js && npm run build:orbit && npm run build:notes",
    "typecheck": "tsc -p tsconfig.json",
    "check:csp": "node tools/check-csp.mjs",
    "watch:css": "sass --watch src/styles/main.scss:assets/css/main.css --style=compressed --no-source-map",
    "watch:js": "esbuild src/js/app.js --bundle --minify --format=iife --target=es2018 --outfile=assets/js/main.js --watch",
    "watch:orbit": "esbuild src/js/orbit.ts --bundle --minify --format=iife --target=es2018 --outfile=assets/js/orbit.js --watch",
    "watch:notes": "esbuild src/js/notes.js --bundle --minify --format=iife --target=es2018 --outfile=assets/js/notes.js --watch",
    "fonts": "node tools/fonts.mjs",
    "icons": "node tools/icons.mjs",
    "brand": "node tools/brand.mjs",
    "cards": "node tools/note-cards.mjs",
    "serve": "bundle exec jekyll serve --force_polling",
    "serve:light": "bundle exec jekyll build && node tools/serve.mjs 4001 _site",
    "dev": "npm run build && concurrently -k -n css,js,orbit,notes,jekyll \"npm:watch:css\" \"npm:watch:js\" \"npm:watch:orbit\" \"npm:watch:notes\" \"npm:serve\"",
    "test": "playwright test",
    "lhci": "lhci autorun",
    "validate:html": "html-validate \"_site/**/*.html\"",
    "prepare": "simple-git-hooks",
    "verify": "npm run build && npm run typecheck && npm run check:csp && bundle exec jekyll build && npm run validate:html && playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@capsizecss/metrics": "^4.4.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource/fragment-mono": "^5.3.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.1",
    "@resvg/resvg-js": "^2.6.2",
    "@tabler/icons": "^3.49.0",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "heic-convert": "^2.1.0",
    "html-validate": "^11.17.0",
    "lucide-static": "^1.61.0",
    "opentype.js": "^2.0.0",
    "png-to-ico": "^3.0.2",
    "sass": "^1.106.1",
    "sharp": "^0.35.5",
    "simple-git-hooks": "^2.14.0",
    "subset-font": "^2.9.0",
    "typescript": "^7.0.2"
  },
  "simple-git-hooks": {
    "pre-commit": "npm run build && npm run typecheck && npm run check:csp && git add assets/css/main.css assets/js/main.js assets/js/orbit.js assets/js/notes.js"
  },
  "overrides": {
    "tmp": "^0.2.7",
    "uuid": "^11.1.1",
    "basic-ftp": "^6.2.3"
  }
}
