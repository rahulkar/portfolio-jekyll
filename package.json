{
  "name": "particle",
  "version": "1.0.0",
  "description": "Source build tooling for rahulkar.com (Jekyll portfolio)",
  "private": true,
  "author": "Rahul Kar",
  "license": "ISC",
  "scripts": {
    "build:css": "sass src/styles/main.scss assets/css/main.css --style=compressed --no-source-map",
    "build:js": "esbuild src/js/app.js --bundle --minify --format=iife --target=es2018 --outfile=assets/js/main.js",
    "build": "npm run build:css && npm run build:js",
    "check:csp": "node tools/check-csp.mjs",
    "watch:css": "sass --watch src/styles/main.scss:assets/css/main.css --style=compressed --no-source-map",
    "watch:js": "esbuild src/js/app.js --bundle --minify --format=iife --target=es2018 --outfile=assets/js/main.js --watch",
    "fonts": "node tools/fonts.mjs",
    "brand": "node tools/brand.mjs",
    "serve": "bundle exec jekyll serve --force_polling",
    "serve:light": "bundle exec jekyll build && node tools/serve.mjs 4001 _site",
    "dev": "npm run build && concurrently -k -n css,js,jekyll \"npm:watch:css\" \"npm:watch:js\" \"npm:serve\"",
    "test": "playwright test",
    "lhci": "lhci autorun",
    "validate:html": "html-validate \"_site/**/*.html\"",
    "prepare": "simple-git-hooks",
    "verify": "npm run build && npm run check:csp && bundle exec jekyll build && npm run validate:html && playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@capsizecss/metrics": "^4.4.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource/fragment-mono": "^5.3.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.56.1",
    "@resvg/resvg-js": "^2.6.2",
    "concurrently": "^9.1.2",
    "esbuild": "^0.25.0",
    "heic-convert": "^2.1.0",
    "html-validate": "^9.5.2",
    "opentype.js": "^1.3.4",
    "png-to-ico": "^3.0.2",
    "sass": "^1.83.4",
    "sharp": "^0.34.4",
    "simple-git-hooks": "^2.11.1",
    "subset-font": "^2.9.0"
  },
  "simple-git-hooks": {
    "pre-commit": "npm run build && npm run check:csp && git add assets/css/main.css assets/js/main.js"
  }
}
