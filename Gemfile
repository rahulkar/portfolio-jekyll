source "https://rubygems.org"

gem "jekyll", "~> 4.3"

# GitHub Pages builds the live site with the github-pages gem (v232), which
# pins these plugins at these versions. Keeping them equal means local and CI
# builds write the same pages as the live one.
group :jekyll_plugins do
  gem "jekyll-sitemap", "1.4.0"
  gem "jekyll-feed", "0.17.0"
  gem "jekyll-seo-tag", "2.8.0"
end
