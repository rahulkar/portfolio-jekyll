---
layout: null
permalink: /feed.xml
sitemap: false
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="{{ site.lang }}">
  <generator uri="https://jekyllrb.com/" version="{{ jekyll.version }}">Jekyll</generator>
  <link href="{{ page.url | absolute_url }}" rel="self" type="application/atom+xml"/>
  <link href="{{ "/notes/" | absolute_url }}" rel="alternate" type="text/html"/>
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <id>{{ page.url | absolute_url | xml_escape }}</id>
  <title type="html">{{ site.title | xml_escape }} | Notes</title>
  <subtitle>{{ site.description | xml_escape }}</subtitle>
  <author><name>{{ site.username | xml_escape }}</name><uri>{{ site.url }}/</uri></author>
  {%- comment -%} Entry IDs stay as they were when notes lived under /scribbles/ (feed_id), so readers do not show them twice. {%- endcomment -%}
  {%- assign notes = site.notes | sort: "date" | reverse -%}
  {%- for note in notes %}
  <entry>
    <title type="html">{{ note.title | xml_escape }}</title>
    <link href="{{ note.url | absolute_url }}" rel="alternate" type="text/html" title="{{ note.title | xml_escape }}"/>
    <published>{{ note.date | date_to_xmlschema }}</published>
    <updated>{{ note.last_modified_at | default: note.date | date_to_xmlschema }}</updated>
    <id>{{ note.feed_id | default: note.id | absolute_url | xml_escape }}</id>
    <content type="html" xml:base="{{ note.url | absolute_url | xml_escape }}">{{ note.content | strip | xml_escape }}</content>
    <summary type="html">{{ note.description | xml_escape }}</summary>
  </entry>
  {%- endfor %}
</feed>
